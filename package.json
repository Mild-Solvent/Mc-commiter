{
  "name": "commit-bubble",
  "version": "0.1.0",
  "description": "A floating, local-first AI commit assistant for Windows",
  "main": "out/main/index.js",
  "author": "DAV Studios",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:e2e": "npm run build && playwright test",
    "build": "npm run typecheck && electron-vite build",
    "generate:icons": "node scripts/generate-icons.mjs",
    "dist:win": "npm run generate:icons && npm run build && electron-builder --win nsis portable --x64",
    "verify:signature": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-signatures.ps1"
  },
  "build": {
    "appId": "studio.dav.commitbubble",
    "productName": "Commit Bubble",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "artifactName": "Commit-Bubble-${version}-${arch}.${ext}",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signtoolOptions": {
        "publisherName": "DAV Studios",
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "nsis": {
      "artifactName": "Commit-Bubble-Setup-${version}-${arch}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Commit Bubble"
    },
    "portable": {
      "artifactName": "Commit-Bubble-Portable-${version}-${arch}.${ext}"
    },
    "publish": null
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
